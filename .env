daemonEnabled=true

# Límites diarios
DAILY_CAP_INSTAGRAM=5
DAILY_CAP_YOUTUBE=5
DAILY_CAP_TIKTOK=5

# Rutas de TikTok
TIKTOK_QUEUE_DIR=queue/default/tiktok/pending
TIKTOK_POSTED_DIR=queue/default/tiktok/posted
TIKTOK_FAILED_DIR=queue/default/tiktok/failed

# Rutas de Instagram
INSTAGRAM_QUEUE_DIR=queue/default/instagram/pending
INSTAGRAM_POSTED_DIR=queue/default/instagram/posted
INSTAGRAM_FAILED_DIR=queue/default/instagram/failed

# Rutas de YouTube
YOUTUBE_QUEUE_DIR=queue/default/youtube/pending
YOUTUBE_POSTED_DIR=queue/default/youtube/posted
YOUTUBE_FAILED_DIR=queue/default/youtube/failed

# Configuración adicional
CRON_EXPRESSION=*/2 * * * *
TZ=America/New_York
HEADLESS=true
